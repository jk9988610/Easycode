{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "outDir": "dist-electron",
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src/main", "src/preload", "vite.config.ts", "electron"]
}
